rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
        && !('isVerifiedSupport' in request.resource.data)
        && !('isAdmin' in request.resource.data);
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isVerifiedSupport', 'isAdmin', 'uid'])
      );
      allow delete: if false;
    }

    match /supportTickets/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'status'])
      );
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if signedIn() && (
          (request.auth.uid == userId && request.resource.data.senderId == userId)
          || (isAdmin() && request.resource.data.senderId == request.auth.uid)
        ) && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }
    }
  }
}